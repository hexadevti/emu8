{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "emu8",
  "compatibility_date": "2026-11-19",
  // static site in dist/; the worker only answers /api/relay/* (send files from a PC to the phone)
  "main": "./worker/relay.js",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
