{
  // F5 debug for the DESKTOP (SDL2) build — runs the same emulator code as the devices, under gdb.
  // Requires the Microsoft C/C++ extension (ms-vscode.cpptools) for the "cppdbg" type.
  // Pick the platform via the EMU_PLATFORM env below (apple2|c64|nes|atari|msx|sms|pcxt).
  // The MinGW bin dir is prepended to PATH so SDL2.dll + the libstdc++/libgcc/winpthread DLLs load.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug emu8 (desktop, choose platform)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/emu8.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [
        { "name": "PATH", "value": "C:\\msys64\\mingw32\\bin;${env:PATH}" },
        { "name": "EMU_PLATFORM", "value": "${input:platform}" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw32\\bin\\gdb.exe",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "desktop: build"
    },
    {
      // SD Manager web app (tools/sdmanager/web): starts the Vite dev server (tasks.json
      // "sdmanager: dev server"), opens it in Chrome with the debugger attached (breakpoints in
      // app.js / protocol.js work), and stops the server when the session ends.
      // Click Connect in the page and pick the board's serial port.
      "name": "SD Manager (web app, Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/tools/sdmanager/web",
      "preLaunchTask": "sdmanager: dev server",
      "postDebugTask": "sdmanager: stop dev server"
    },
    {
      "name": "SD Manager (web app, Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/tools/sdmanager/web",
      "preLaunchTask": "sdmanager: dev server",
      "postDebugTask": "sdmanager: stop dev server"
    }
  ],
  "inputs": [
    {
      "id": "platform",
      "type": "pickString",
      "description": "Which platform to boot?",
      "options": ["apple2", "c64", "nes", "atari", "msx", "sms", "pcxt"],
      "default": "msx"
    }
  ]
}
